# === OKX API keys ===
# Default (OKX_DEMO_TRADING=1): get these from https://www.okx.com -> Profile
# -> API -> "Demo trading" toggle ON. Demo-trading keys ONLY work against the
# demo environment and cannot move real funds.
#
# Alternative — OKX_DEMO_TRADING=0, a LIVE (production) key: as of 2026-09,
# OKX's Demo Trading sandbox has no real liquidity for Event Contracts (no
# maker activity -> market/ticker comes back empty, confirmed both via API
# and in the OKX app itself). A live key reads REAL quotes/liquidity instead.
# This bot still never places a real order either way — src/engine.py has no
# call to okx_client.py's place_event_order() at all, demo or live, so this
# only changes what market data you're reading, never what the bot does with
# your funds. Still, create this key with ONLY "Read" permission checked
# (uncheck Trade/Withdraw) in OKX's API management — belt-and-suspenders in
# case that ever changes.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 1 = send the x-simulated-trading:1 header (OKX Demo Trading / Paper).
# 0 = read LIVE production market data instead (see note above) — needs a
# live (non-demo) key above, matched to the account/region it was created for.
OKX_DEMO_TRADING=1

# Base REST host. Usually you never need to change this.
OKX_BASE_URL=https://www.okx.com

# === Docker data persistence (optional) ===
# Host path for data/ (bot.db, bot.log) when running via docker-compose.
# Leave unset to use ./data next to docker-compose.yml — fine if your
# redeploy reuses the same checkout directory. If your deploy process
# instead re-clones the repo into a fresh directory each time, set this to
# a STABLE ABSOLUTE PATH outside any git checkout so history survives
# redeploys, e.g.:
# BOT_DATA_DIR=/var/lib/okx-event-bot-data
BOT_DATA_DIR=

# === Web dashboard password (optional) ===
# Set this to require a password before the dashboard (or its /api/*)
# loads at all — a login sets a signed cookie that persists for 30 days.
# Leave empty/unset for no auth at all (fine for localhost-only use).
# Recommended whenever the dashboard is reachable from outside your own
# machine (see README "Деплой на сервер").
DASHBOARD_PASSWORD=

# === ai_prompt strategy (optional, disabled by default in config.yaml) ===
# Costs money per call — the strategy stays disabled
# (config.yaml -> strategies.ai_prompt.enabled) until you both set the
# right key below AND flip that flag. Which key you need depends on
# config.yaml -> strategies.ai_prompt.provider (default: requesty).

# provider: requesty (default) — https://app.requesty.ai, one key routes to
# 600+ models from any provider (see config.yaml for model recommendations).
REQUESTY_API_KEY=
# Usually no need to change these:
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=

# provider: deepseek — talks to DeepSeek directly instead, no router.
# Get a key at https://platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# provider: openai_compatible — generic escape hatch for any other
# OpenAI-shaped gateway.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
